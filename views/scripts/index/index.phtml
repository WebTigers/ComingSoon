/**
 * The ComingSoon holding page — a complete, self-contained document (the layout is disabled).
 * The only inlined CSS is the selected SKIN FILE's contents (base + skin), read from disk by the
 * controller — skins stay separate, swappable files; the page stays a single request with no CDN.
 * No bespoke CSS is authored here; markup is semantic and skinned entirely by the skin's variables.
 *
 * Content is the owner's: an editable HEADING + TAGLINE, and an optional background MEDIA (image or
 * video). When a background is set, it renders behind the message with a legibility scrim.
 */
$e  = fn($s) => $this->escape((string) $s);
$bg = $this->background ?? null;   // ['url','kind'=>'image'|'video','mime'] or null
?><!doctype html>
<html lang="en" data-cs-skin="<?= $e($this->skinName) ?>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><?= $e($this->siteName) ?></title>
<?php if ($this->tagline): ?><meta name="description" content="<?= $e($this->tagline) ?>"><?php endif; ?>
<meta property="og:title" content="<?= $e($this->siteName) ?>">
<?php if ($this->tagline): ?><meta property="og:description" content="<?= $e($this->tagline) ?>"><?php endif; ?>
<meta property="og:type" content="website">
<link rel="icon" href="data:,">
<style><?= $this->skinCss ?></style>
</head>
<body class="cs cs--<?= $e($this->layoutVariant) ?><?= $bg ? ' cs--has-bg' : '' ?>">
<?php if ($bg): ?>
    <?php if ($bg['kind'] === 'video'): ?>
    <video class="cs__bg cs__bg--video" autoplay muted loop playsinline aria-hidden="true">
        <source src="<?= $e($bg['url']) ?>"<?php if (!empty($bg['mime'])): ?> type="<?= $e($bg['mime']) ?>"<?php endif; ?>>
    </video>
    <?php else: ?>
    <div class="cs__bg cs__bg--image" style="background-image:url('<?= $e($bg['url']) ?>')" aria-hidden="true"></div>
    <?php endif; ?>
    <div class="cs__bg-scrim" aria-hidden="true"></div>
<?php endif; ?>
<main class="cs__stage">
    <div class="cs__inner">
        <h1 class="cs__name"><?= $e($this->heading) ?></h1>
        <?php if ($this->tagline): ?><p class="cs__tagline"><?= $e($this->tagline) ?></p><?php endif; ?>
    </div>
</main>
<?php if ($this->email || !empty($this->social)): ?>
<footer class="cs__footer">
    <?php if (!empty($this->social)): ?>
    <nav class="cs__social" aria-label="Social links">
        <?php foreach ($this->social as $s): ?>
        <a class="cs__social-link" href="<?= $e($s['url']) ?>" rel="noopener noreferrer" target="_blank" aria-label="<?= $e($s['label']) ?>" title="<?= $e($s['label']) ?>">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="20" height="20"><?= $s['glyph'] ?></svg>
        </a>
        <?php endforeach; ?>
    </nav>
    <?php endif; ?>
    <?php if ($this->email): ?>
    <a class="cs__social-link cs__email" href="mailto:<?= $e($this->email) ?>" aria-label="<?= $e($this->email) ?>" title="<?= $e($this->email) ?>">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="20" height="20"><?= Comingsoon_Content::socialGlyph('email') ?></svg>
    </a>
    <?php endif; ?>
</footer>
<?php endif; ?>
</body>
</html>
